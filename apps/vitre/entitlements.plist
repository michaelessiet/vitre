<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The bundled Node sidecar runs V8 under the hardened runtime; without the
     JIT/unsigned-executable-memory entitlements it dies at isolate init with
     "Failed to reserve virtual memory for CodeRange". Library validation is
     disabled so ad-hoc/differently-signed native addons (node-pty, fff) load. -->
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
