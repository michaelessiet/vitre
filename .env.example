# Optional local development settings. Copy to `.env` (or `.env.local`) at the repo root.
# Do not add secrets to this file.

# macOS only: a codesigning identity for `vp run dev:vitre`, so Screen Recording access
# survives rebuilds. Without it the dev build is signed ad hoc.
# VITRE_SIGNING_IDENTITY="Apple Development: Your Name (TEAMID)"
