# Deployment tooling only. Never place these values in desktop builds.
RELAY_STACK_NAME=VitrePersonalRelay
RELAY_PERSONAL_DEPLOYMENT=true
RELAY_MOBILE_ENABLED=false
# Provision PostgreSQL and use its direct endpoint; Hyperdrive supplies pooling.
RELAY_DATABASE_ADMIN_URL=postgresql://vitre_owner:OWNER_PASSWORD@database.example.com:5432/vitre?sslmode=require
# Use the same host/database, username vitre_relay and a separate strong password.
# Deployment creates this restricted role with limited permissions.
RELAY_DATABASE_URL=postgresql://vitre_relay:RUNTIME_PASSWORD@database.example.com:5432/vitre?sslmode=require
# For a private CA (including Railway postgres-ssl), supply both settings.
# Quote the complete multiline PEM and upload the same CA to Cloudflare.
RELAY_DATABASE_CA_CERT=
RELAY_DATABASE_CA_CERTIFICATE_ID=
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=workers.example.com
RELAY_DOMAIN=vitre-cloud.example.com

# Keep disabled until the compatibility proof and native pilot pass.
VITRE_CLOUD_ENABLED=false
VITRE_CLOUD_ALLOWED_USER_ID=
# Existing AWS machine agent's authenticated HTTPS endpoint and credential.
VITRE_CLOUD_MACHINE_URL=
VITRE_CLOUD_MACHINE_TOKEN=
# Base64-encoded, randomly generated 32-byte AES key. Keep it across deployments.
VITRE_CLOUD_ENCRYPTION_KEY=
VITRE_GITHUB_APP_ID=
VITRE_GITHUB_PRIVATE_KEY=
VITRE_GITHUB_INSTALLATION_IDS=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_AUDIENCE=

# Supply the existing Alchemy Cloudflare and Axiom deployment
# credentials through your secure environment, as required by infra/relay.
