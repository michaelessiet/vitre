# Required: direct PostgreSQL URLs for the same database (no transaction pooler).
# Owner URL is used only by the deployment migration runner.
RELAY_DATABASE_ADMIN_URL=postgresql://vitre_owner:OWNER_PASSWORD@database.example.com/vitre?sslmode=require
# Choose a strong URL-encoded password; deploy creates this restricted SQL role.
RELAY_DATABASE_URL=postgresql://vitre_relay:RUNTIME_PASSWORD@database.example.com/vitre?sslmode=require

# Optional: a private CA dedicated to this database, such as Railway postgres-ssl.
# Set both values together, or omit both to use system certificate/hostname trust.
# Obtain the PEM through authenticated service access and upload the same CA to Cloudflare.
# RELAY_DATABASE_CA_CERT="PASTE_THE_COMPLETE_MULTILINE_PEM_CERTIFICATE_HERE"
# RELAY_DATABASE_CA_CERTIFICATE_ID=CLOUDFLARE_UPLOADED_CA_CERTIFICATE_ID
# Custom trust verifies the CA and expiry, without matching the TCP proxy hostname.
# On CA rotation, update the PEM and uploaded CA ID together, then redeploy Hyperdrive.

# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Detailed Axiom HTTP traces default off for personal deployments to reduce CPU.
# Cloudflare invocation logs and metrics remain available. Enable for diagnostics.
# RELAY_HTTP_TRACING_ENABLED=true

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Required: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
