+  // Transaction poolers such as Hyperdrive omit BackendKeyData. A null PID
+  // cannot cancel anything; close the checked-out connection instead. pg marks
+  // it as ending, so neither normal nor transaction release can reuse it.
+  const eff = globalThis.Number.isInteger(processId) && processId > 0
     // query cancelation is best-effort, so we don't fail if it doesn't work
     ? Effect.callback<void>((resume) => {
       if (pool.ending) return resume(Effect.void)
@@ -787,7 +790,7 @@ const makeCancel = (pool: Pg.Pool, client: Pg.PoolClient) => {
       Effect.interruptible,
       Effect.timeoutOption(5000)
     )
-    : undefined
+    : Effect.promise(() => client.end()).pipe(Effect.timeoutOption(1000), Effect.asVoid)
   cancelEffects.set(client, eff)
   return eff
 }
